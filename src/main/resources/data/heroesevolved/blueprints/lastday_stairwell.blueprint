# The Last Day's way down: a switchback from Primatech's lobby to the safe house's vault door.
# Placed by PrologueService.LastDayData at the bunker's origin (its north door) in time_fracture.
# The city draws y 63 up (Landmarks.safeHouse); the vault's panel is placed by code (PrologueService.vault).
name: lastday_stairwell
anchor: 4 1 8
palette:
  S = deepslate
  F = polished_deepslate
  D = deepslate_tiles
  A = yellow_concrete
  C = black_concrete
  E = polished_blackstone_bricks
  G = chiseled_polished_blackstone
  I = iron_block
  Q = tuff_bricks
  H = polished_deepslate_stairs[facing=east]
  J = polished_blackstone_brick_wall
  K = spruce_stairs[facing=west]
  M = waxed_weathered_cut_copper
  N = spruce_wall_sign[facing=north] @sign:vault
  B = deepslate_bricks
  L = sea_lantern
  O = waxed_copper_bulb[lit=true]
  P = polished_deepslate_stairs[facing=west]
signs:
  vault yellow glow = SUBLEVEL 4|STASIS WING|PRIMATECH|SHELTER

