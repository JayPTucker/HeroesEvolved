# Temporary refuge; rooted podium, broken colonnade and three-wide exit arch. Snapshot every cell; never replace player blocks.
name: end_refuge
anchor: 12 4 10
palette:
  A = minecraft:air
  B = minecraft:end_stone_bricks
  C = minecraft:end_stone
  D = minecraft:purpur_block
  E = minecraft:smooth_sandstone
  F = minecraft:sea_lantern
  G = minecraft:purpur_pillar[axis=y]
  H = minecraft:air @return
  I = minecraft:chiseled_sandstone
  J = minecraft:air @rally

