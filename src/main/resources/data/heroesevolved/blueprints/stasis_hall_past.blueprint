# Generated by tools/generate-bunker.py; change the script, not this file.
# The stasis hall: fourteen pods in arched niches under catwalks, the orientation log in the aisle, a grand stair to the balcony under Exhibit 1.
# As it was on the Last Day and the lockdown nights (PastBunker).
# Placed with its grid corner at bunker -10 0 32 (BunkerLayout).
name: stasis_hall_past
anchor: 0 0 0
palette:
  A = polished_deepslate
  B = waxed_copper_grate
  C = deepslate_tiles
  D = polished_tuff
  E = chiseled_tuff_bricks
  F = waxed_cut_copper
  G = heroesevolved:cryochamber[facing=east,half=lower,open=false] @pod
  H = heroesevolved:cryochamber[facing=west,half=lower,open=false] @pod
  I = chest[facing=north,type=single,waterlogged=false] @log:orientation
  J = waxed_cut_copper_slab[type=bottom]
  K = polished_deepslate_stairs[facing=south,half=bottom]
  L = spruce_stairs[facing=north]
  M = polished_deepslate_slab[type=top]
  N = polished_deepslate_wall
  O = lightning_rod[facing=up]
  P = heroesevolved:cryochamber[facing=east,half=upper,open=false]
  Q = heroesevolved:cryochamber[facing=west,half=upper,open=false]
  R = iron_bars
  S = polished_blackstone_button[face=floor,facing=north]
  T = black_stained_glass
  U = gray_stained_glass
  V = spruce_wall_sign[facing=east] @sign:pod01
  W = spruce_wall_sign[facing=west] @sign:pod08
