# Containment: Gabriel Gray. The bars were not cut; they were unmade. The blood trail ends at his cage.
# Visitors hear ticking. BunkerBuilder.inCell matches this interior.
name: bunker_cell
anchor: 0 0 0
palette:
  A = polished_deepslate
  B = cracked_deepslate_bricks
  C = bone_block[axis=x]
  D = skeleton_skull[rotation=6]
  E = iron_bars
  F = gray_bed[facing=south,part=head]
  G = redstone_wire
  H = gray_bed[facing=south,part=foot]
  I = dark_oak_stairs[facing=south]
  J = spruce_slab[type=top]
  K = lectern[facing=north] @log:gabriel
  L = chest[facing=west] @loot:cell
  M = chiseled_deepslate
  N = tripwire_hook[facing=north]
  O = candle[candles=3,lit=false]
  P = cobweb
  Q = deepslate_bricks
  R = soul_lantern[hanging=true]

