# Infirmary: the old recovery room (two cots, intake desk, the screened recovery bays, medical storage) opens
# through an arch into a west ward with two more cots, a frosted screen, a medicine cabinet and hanging lamps.
# The east opening joins the corridor. Every cell of the old room keeps its place (anchor 5 0 0 is the old
# north-west corner): the gray cot, the survivors' spots and the chest are read by code and tests.
name: bunker_cell
anchor: 5 0 0
palette:
  A = polished_deepslate
  B = smooth_stone
  C = cyan_terracotta
  D = deepslate_bricks
  E = cracked_deepslate_bricks
  F = smooth_quartz
  G = white_bed[facing=east,part=foot]
  H = white_bed[facing=east,part=head]
  I = white_bed[facing=west,part=head]
  J = white_bed[facing=west,part=foot]
  K = iron_bars
  L = light_blue_stained_glass_pane
  M = white_stained_glass_pane
  N = gray_bed[facing=south,part=foot]
  O = air @signal:survivor
  P = gray_bed[facing=south,part=head]
  Q = dark_oak_stairs[facing=south]
  R = barrel[facing=up]
  S = white_concrete
  T = spruce_slab[type=top]
  U = chest[facing=west]
  V = brewing_stand
  W = flower_pot
  X = candle[candles=2,lit=true]
  Y = spruce_wall_sign[facing=north] @sign:infirmary
  Z = chiseled_deepslate
  a = spruce_trapdoor[facing=south,half=top,open=false]
  b = waxed_copper_bulb[lit=true]
  c = chain[axis=y]
  d = cobweb
  e = waxed_weathered_cut_copper
  f = waxed_weathered_cut_copper_slab[type=top]
  g = waxed_weathered_copper_bulb[lit=true]
  h = sea_lantern
signs:
  infirmary white glow = INFIRMARY | RECOVERY COTS | KEEP CLEAR

