# Infirmary: two cots, medical storage and a screened recovery area. The east opening joins the corridor.
name: bunker_cell
anchor: 0 0 0
palette:
  A = polished_deepslate
  B = cracked_deepslate_bricks
  C = white_bed[facing=east,part=foot]
  D = white_bed[facing=east,part=head]
  E = light_blue_stained_glass_pane
  F = gray_bed[facing=south,part=head]
  H = gray_bed[facing=south,part=foot]
  I = dark_oak_stairs[facing=south]
  J = spruce_slab[type=top]
  K = smooth_quartz
  L = chest[facing=west]
  M = chiseled_deepslate
  O = flower_pot
  P = cobweb
  Q = deepslate_bricks
  R = waxed_weathered_copper_bulb[lit=true]
  S = air @signal:survivor
  T = spruce_wall_sign[facing=north] @sign:infirmary
  U = cyan_terracotta
  V = sea_lantern
  W = waxed_copper_bulb[lit=true]
signs:
  infirmary white glow = INFIRMARY | RECOVERY COTS | KEEP CLEAR

