# A town house villages build at the Town tier (village/Projects): side gable, brick ground floor, plank
# upper floor in a log frame, deepslate-tile roof and a chimney. Drawn facing north; village/Styles
# recolours it per village kind. Exported with to-nbt to structure/village/town_house_2.nbt.
name: village_town_house_2
anchor: 0 0 0
palette:
  A = cobblestone
  B = spruce_planks
  C = oak_log[axis=y]
  D = bricks
  E = oak_door[facing=south,half=lower,hinge=left]
  F = bookshelf
  G = furnace[facing=west]
  H = oak_stairs[facing=north,half=bottom]
  I = barrel[facing=up]
  J = oak_fence
  K = oak_stairs[facing=south,half=bottom]
  L = crafting_table
  M = oak_planks
  N = oak_stairs[facing=west,half=bottom]
  O = glass_pane
  P = oak_door[facing=south,half=upper,hinge=left]
  Q = oak_pressure_plate
  R = dark_oak_trapdoor[facing=north,half=top,open=false]
  S = lantern[hanging=true]
  T = flowering_azalea_leaves[persistent=true]
  U = oak_log[axis=x]
  V = oak_log[axis=z]
  W = blue_bed[facing=south,part=foot]
  X = yellow_bed[facing=south,part=foot]
  Y = chest[facing=west]
  Z = blue_bed[facing=south,part=head]
  a = yellow_bed[facing=south,part=head]
  b = blue_carpet
  c = deepslate_tile_stairs[facing=south,half=bottom]
  d = deepslate_tile_stairs[facing=north,half=bottom]
  e = chain[axis=y]
  f = deepslate_tile_slab[type=bottom]
  g = campfire[lit=true,signal_fire=false,facing=north]

