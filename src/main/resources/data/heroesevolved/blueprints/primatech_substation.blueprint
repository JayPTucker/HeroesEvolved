# Primatech's test floor: Elle Bishop's arena (story/elle/PrimatechArena), rebuilt before every fight in the
# heroesevolved:primatech_substation dimension. The anchor is the floor block in the middle of the room.
# @bank:N is bank N's middle, @breaker:N its lever, @bulb:N its lights, @rod:N its top, @conduit:N its floor strip;
# @mat is rubber floor, @light the ceiling bulbs the third phase puts out. Banks are numbered clockwise from north-west.
# Generated by a draft script; positions must match story/elle/PrimatechGeometry.
name: primatech_substation
anchor: 13 0 17
palette:
  A = cracked_deepslate_tiles
  B = deepslate_tiles
  C = smooth_stone
  D = waxed_cut_copper
  E = polished_deepslate
  F = waxed_cut_copper @conduit:0
  G = waxed_cut_copper @conduit:1
  H = black_wool @mat
  I = waxed_cut_copper @conduit:5
  J = waxed_cut_copper @center
  K = waxed_cut_copper @conduit:2
  L = waxed_cut_copper @conduit:4
  M = waxed_cut_copper @conduit:3
  N = polished_blackstone
  O = polished_blackstone_wall
  P = iron_block
  Q = air @spawn:elle
  R = polished_blackstone_slab[type=bottom]
  S = air @spawn:player
  T = iron_trapdoor[facing=north,half=bottom,open=true]
  U = waxed_copper_bulb[lit=true] @bulb:0
  V = iron_block @bank:0
  W = waxed_copper_bulb[lit=true] @bulb:1
  X = iron_block @bank:1
  Y = lever[face=wall,facing=south,powered=true] @breaker:0
  Z = lever[face=wall,facing=south,powered=true] @breaker:1
  a = waxed_copper_bulb[lit=true] @bulb:5
  b = waxed_copper_bulb[lit=true] @bulb:2
  c = iron_block @bank:5
  d = lever[face=wall,facing=east,powered=true] @breaker:5
  e = lever[face=wall,facing=west,powered=true] @breaker:2
  f = iron_block @bank:2
  g = lever[face=wall,facing=north,powered=true] @breaker:4
  h = lever[face=wall,facing=north,powered=true] @breaker:3
  i = waxed_copper_bulb[lit=true] @bulb:4
  j = iron_block @bank:4
  k = waxed_copper_bulb[lit=true] @bulb:3
  l = iron_block @bank:3
  m = chain
  n = waxed_copper_block
  o = iron_bars
  p = barrel[facing=up]
  q = dark_oak_slab[type=top]
  r = dark_oak_stairs[facing=north,half=top]
  s = lightning_rod[facing=up] @rod:0
  t = lightning_rod[facing=up] @rod:1
  u = lightning_rod[facing=up] @rod:5
  v = lightning_rod[facing=up] @rod:2
  w = lightning_rod[facing=up] @rod:4
  x = lightning_rod[facing=up] @rod:3
  y = lever[face=floor,facing=north]
  z = redstone_torch
  0 = comparator[facing=north]
  1 = tinted_glass
  2 = waxed_copper_bulb[lit=true]
  3 = redstone_block
  4 = lightning_rod[facing=south]
  5 = waxed_copper_bulb[lit=false]
  6 = lightning_rod[facing=east]
  7 = waxed_copper_grate
  8 = lightning_rod[facing=down]
  9 = red_stained_glass
  ! = deepslate_bricks
  $ = waxed_copper_bulb[lit=true] @light
  % = glowstone

