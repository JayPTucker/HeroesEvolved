# A timber-frame family home that burned when the city did. The fire began in the kitchen (south-west);
# charring fades with distance from there. Generated across the overworld.
# Exported to data/heroesevolved/structure/ruins/burnt_house.nbt.
name: ruins_burnt_house
anchor: 0 0 0
palette:
  f = spruce_planks
  s = soul_soil
  S = stone_bricks
  c = cracked_stone_bricks
  W = stripped_birch_wood
  D = stripped_spruce_wood
  B = blackstone
  L = stripped_dark_oak_log[axis=y]
  l = stripped_dark_oak_log[axis=x]
  g = iron_bars
  K = furnace[facing=east]
  F = campfire[lit=false,facing=east]
  k = spruce_slab[type=top]
  e = spruce_fence
  t = spruce_pressure_plate
  q = spruce_stairs[facing=west]
  Q = spruce_stairs[facing=east]
  a = gray_carpet
  X = chest[facing=west] @loot:ruins_house
  m = moss_carpet
  C = coarse_dirt
  v = short_grass
  V = vine[north=true]
  d = dead_bush

