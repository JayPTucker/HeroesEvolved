# Maintenance bay. The hatch in security leads to a workbench, map desk, cot and spare storage.
name: bunker_office
anchor: 0 0 0
palette:
  A = dark_oak_planks
  B = spruce_planks
  C = deepslate_tiles
  D = stripped_dark_oak_wood
  E = dark_oak_log[axis=y]
  F = chest[facing=south]
  G = gray_bed[facing=north,part=head]
  H = dark_oak_slab[type=top]
  I = gray_bed[facing=north,part=foot]
  J = dark_oak_stairs[facing=south]
  K = gray_carpet
  L = crafting_table
  M = cartography_table
  N = barrel[facing=up]
  O = ladder[facing=north]
  P = chiseled_bookshelf[facing=west,slot_0_occupied=true,slot_5_occupied=true]
  Q = lantern[hanging=false]
  R = black_stained_glass_pane
  S = flower_pot
  T = candle[candles=2,lit=false]
  U = chiseled_bookshelf[facing=west,slot_1_occupied=true,slot_3_occupied=true]
  W = spruce_wall_sign[facing=north] @sign:office
  X = cobweb
  Y = waxed_copper_bulb[lit=true]
  Z = deepslate_bricks
signs:
  office white glow = MAINTENANCE | WORKBENCH | SPARE STORAGE

