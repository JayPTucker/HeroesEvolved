# Sublevel 4-B: Noah Bennet's office, on no plan. Reached by the trapdoor under the red rug in security.
# His letter to Claire is on the lectern; her blood, kept cold, is in the chest. The family photo hangs over the desk.
name: bunker_office
anchor: 0 0 0
palette:
  A = dark_oak_planks
  B = spruce_planks
  C = deepslate_tiles
  D = stripped_dark_oak_wood
  E = dark_oak_log[axis=y]
  F = chest[facing=south] @loot:office
  G = gray_bed[facing=north,part=head]
  H = dark_oak_slab[type=top]
  I = gray_bed[facing=north,part=foot]
  J = dark_oak_stairs[facing=south]
  K = gray_carpet
  L = lectern[facing=west] @log:bennet
  M = cartography_table
  N = barrel[facing=up]
  O = ladder[facing=north]
  P = chiseled_bookshelf[facing=west,slot_0_occupied=true,slot_5_occupied=true]
  Q = lantern[hanging=false]
  R = black_stained_glass_pane
  S = flower_pot
  T = candle[candles=2,lit=false]
  U = chiseled_bookshelf[facing=west,slot_1_occupied=true,slot_3_occupied=true]
  V = air @painting:bennets:south
  W = spruce_wall_sign[facing=north] @sign:office
  X = cobweb
  Y = waxed_copper_bulb[lit=true]
  Z = deepslate_bricks
signs:
  office black = SUBLEVEL 4-B | N. BENNET | NOT ON THE | PLANS

