# The Formula lab, abandoned: a long bench of instruments (the Centrifuge and Synthesis Station among them),
# the Helixite assay on its lectern, specimen tubes (one broken), the sample chest in the island, and a lit
# specimen tank at the far end. Copper ribs and hanging bulbs under the ceiling. The chest, lectern and door
# keep their old cells: BunkerLayoutUpgrade, the tests and the corridor depend on them.
name: bunker_lab
anchor: 0 0 0
palette:
  A = polished_deepslate
  B = yellow_concrete
  C = polished_tuff
  D = black_concrete
  E = deepslate_tiles
  F = yellow_terracotta
  G = smooth_quartz
  H = white_carpet
  I = waxed_copper_grate
  J = chest[facing=west] @loot:lab
  K = sea_lantern
  L = lectern[facing=north] @log:helixite
  M = iron_trapdoor[facing=north,open=true,half=bottom]
  N = barrel[facing=up]
  O = iron_block
  P = tuff_bricks
  Q = amethyst_cluster[facing=up]
  R = flower_pot
  S = heroesevolved:centrifuge[facing=south]
  T = heroesevolved:synthesis_station[facing=south]
  U = brewing_stand
  V = cauldron
  W = black_stained_glass_pane
  X = glass
  Y = kelp_plant
  Z = water
  a = light_blue_stained_glass
  b = kelp
  c = cobweb
  d = iron_trapdoor[facing=north,half=top,open=false]
  e = lightning_rod[facing=east]
  f = waxed_copper_bulb[lit=true]
  g = waxed_cut_copper
  h = waxed_weathered_cut_copper
  i = waxed_weathered_cut_copper_slab[type=top]
  j = chain[axis=y]

