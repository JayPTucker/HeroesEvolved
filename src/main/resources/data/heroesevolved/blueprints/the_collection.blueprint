# Sylar's Collection: the round hall his fight is in, rebuilt before every fight in heroesevolved:the_collection.
# Drafted by tools/draft-the-collection.py from SylarGeometry's numbers: change the script, not this file.
# @case:N (lower glass of hour N's case), @cover:N (floor under pillar N), @spawn:sylar, @spawn:party, @lamp.
name: the_collection
anchor: 24 1 24
palette:
  A = deepslate
  B = deepslate_tiles
  C = dark_oak_planks
  D = polished_blackstone_bricks
  E = polished_deepslate
  F = waxed_exposed_cut_copper
  G = polished_deepslate @cover:3
  H = polished_deepslate @cover:0
  I = waxed_copper_bulb[lit=true] @lamp
  J = smooth_quartz
  K = waxed_copper_block
  L = waxed_copper_block @spawn:sylar
  M = polished_deepslate @cover:2
  N = polished_deepslate @cover:1
  O = waxed_exposed_cut_copper @spawn:party
  P = sea_lantern
  Q = dark_oak_fence
  R = glass @case:0
  S = glass @case:11
  T = glass @case:1
  U = glass @case:10
  V = glass @case:2
  W = glass @case:9
  X = glass @case:3
  Y = glass @case:8
  Z = glass @case:4
  a = glass @case:7
  b = glass @case:5
  c = glass @case:6
  d = glass
  e = polished_blackstone_brick_slab[type=bottom]
  f = waxed_cut_copper_slab[type=bottom]
  g = deepslate_bricks

