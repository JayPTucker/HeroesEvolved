# The corridor between records and stasis, with the Formula lab east and the infirmary west.
name: bunker_corridor
anchor: 2 0 0
palette:
  A = polished_deepslate
  B = polished_tuff
  C = yellow_concrete
  D = deepslate_tiles
  F = spruce_wall_sign[facing=east] @sign:cell
  G = spruce_wall_sign[facing=west] @sign:lab
  H = polished_deepslate_stairs[facing=west,half=top]
  I = polished_deepslate_stairs[facing=east,half=top]
  K = lightning_rod[facing=north]
  L = chain[axis=z]
  M = deepslate_bricks
  N = waxed_copper_bulb[lit=true]
  P = heroesevolved:alarm_beacon[facing=down,lit=true] @beacon
signs:
  cell white glow = INFIRMARY | RECOVERY | WEST
  lab white glow = FORMULA LAB | STAFF ONLY | 

