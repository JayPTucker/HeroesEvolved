# The generator hall: fourteen power cells on the walls, three still burning, around a cold reactor.
# When the last cell dies, the pods open. Placed east of the records room, sharing its east wall.
name: bunker_generator
anchor: 0 0 0
palette:
  A = polished_deepslate
  B = yellow_concrete
  C = black_concrete
  D = deepslate_tiles
  E = skeleton_skull[rotation=4]
  F = white_carpet
  G = waxed_copper_block
  H = iron_block
  I = ladder[facing=south]
  J = barrel[facing=up]
  K = smooth_quartz_slab[type=top]
  L = tuff_bricks
  M = waxed_oxidized_copper_bulb[lit=false]
  N = waxed_copper_bulb[lit=true]
  O = spruce_wall_sign[facing=south] @sign:cells
  P = waxed_weathered_cut_copper
  Q = tinted_glass
  R = magma_block
  S = black_stained_glass_pane
  T = lever[face=floor,facing=north]
  U = polished_deepslate_slab[type=bottom]
  V = orange_stained_glass
  W = waxed_weathered_cut_copper_slab[type=top]
  X = iron_trapdoor[facing=north,open=true,half=bottom]
  Y = iron_trapdoor[facing=west,open=true,half=bottom]
  Z = iron_trapdoor[facing=east,open=true,half=bottom]
  a = iron_bars
  b = iron_trapdoor[facing=south,open=true,half=bottom]
  c = lightning_rod[facing=east]
  d = lightning_rod[facing=north]
  e = chain[axis=y]
  f = waxed_copper_grate
  g = deepslate_bricks
  h = red_stained_glass
signs:
  cells red glow = POWER CELLS | 3 OF 14 | REMAINING | 

