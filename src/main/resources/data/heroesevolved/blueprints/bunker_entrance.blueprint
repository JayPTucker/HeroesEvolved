# The way back down: a ruined concrete hut around the bunker hatch, with a radio mast that marks it from afar.
# Placed with its anchor on the hatch at the surface; the hatch cell itself is left alone.
name: bunker_entrance
anchor: 4 0 4
palette:
  A = short_grass
  B = dead_bush
  C = polished_andesite
  D = light_gray_concrete
  E = cracked_stone_bricks
  F = smooth_stone
  G = fern
  H = cobblestone
  I = cobblestone_slab[type=bottom]
  J = moss_carpet
  K = spruce_wall_sign[facing=south] @sign:site
  L = vine[west=true]
  M = vine[north=true]
  N = smooth_stone_slab[type=top]
  O = smooth_stone_slab[type=bottom]
  P = moss_block
  Q = iron_bars
  R = smooth_quartz_stairs[facing=east]
  S = smooth_quartz_stairs[facing=east,half=top]
  T = red_stained_glass
  U = lightning_rod[facing=up]
signs:
  site white = ODESSA SITE | RESTRICTED | PRIMATECH | RESEARCH

