  w = polished_deepslate_stairs[facing=north,half=top]
  x = heroesevolved:alarm_beacon[facing=south,lit=true] @beacon
  y = polished_deepslate_stairs[facing=west,half=top]
  z = polished_deepslate_stairs[facing=east,half=top]
