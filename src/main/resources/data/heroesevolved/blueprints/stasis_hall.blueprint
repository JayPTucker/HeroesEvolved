# Generated by tools/generate-bunker.py; change the script, not this file.
# The stasis hall: fourteen pods in arched niches under catwalks, the orientation log in the aisle, a grand stair to the balcony under Exhibit 1.
# A hundred and three years later: the bunker new players wake in.
# Placed with its grid corner at bunker -10 0 32 (BunkerLayout).
name: stasis_hall
anchor: 0 0 0
palette:
  A = polished_deepslate
  B = waxed_weathered_copper_grate
  C = deepslate_tiles
  D = polished_tuff
  E = chiseled_tuff_bricks
  F = cracked_deepslate_tiles
  G = calcite
  H = moss_carpet
  I = redstone_wire
  J = waxed_weathered_cut_copper
  K = heroesevolved:cryochamber[facing=east,half=lower,open=false] @pod
  L = heroesevolved:cryochamber[facing=west,half=lower,open=false] @pod
  M = chest[facing=north,type=single,waterlogged=false] @log:orientation
  N = cobbled_deepslate
  O = cobbled_deepslate_slab[type=bottom]
  P = tuff
  Q = smooth_quartz
  R = waxed_weathered_copper_trapdoor[facing=north,half=bottom,open=false]
