  T = waxed_weathered_cut_copper_slab[type=bottom]
  U = polished_deepslate_stairs[facing=south,half=bottom]
  V = spruce_stairs[facing=north]
  W = polished_deepslate_slab[type=top]
  X = polished_deepslate_wall
  Y = lightning_rod[facing=up]
  Z = heroesevolved:cryochamber[facing=east,half=upper,open=false]
  a = heroesevolved:cryochamber[facing=west,half=upper,open=false]
  b = polished_deepslate_stairs[facing=east]
  c = iron_bars
  d = polished_blackstone_button[face=floor,facing=north]
  e = black_stained_glass
  f = gray_stained_glass
