# A brick house the blast wave pushed over from the east. The west wall and the chimney still stand;
# the rest is a slope of rubble and roof tiles. Generated across the overworld.
# Exported to data/heroesevolved/structure/ruins/collapsed_house.nbt.
name: ruins_collapsed_house
anchor: 0 0 0
palette:
  S = stone_bricks
  f = oak_planks
  R = bricks
  k = stone_brick_slab[type=top]
  y = brick_slab[type=bottom]
  w = brick_wall
  N = campfire[lit=false,facing=east]
  p = glass_pane
  c = cobblestone
  C = mossy_cobblestone
  u = deepslate_tile_stairs[facing=east]
  U = deepslate_tile_stairs[facing=west,half=top]
  h = deepslate_tile_slab[type=bottom]
  m = moss_carpet
  v = short_grass
  F = fern
  V = vine[west=true]
  X = chest[facing=east] @loot:ruins_house

