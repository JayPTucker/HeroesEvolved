# Gray & Sons: Sylar's clock shop, the Watchmaker's arena (story/sylar/WatchmakerArena).
# Built fresh before every fight in the heroesevolved:watchmaker_shop dimension. The anchor is the clock face's middle.
# @rail:n/@rail:s are the gear-rail posts; @door:front locks in phase two; @door:back bursts when he runs;
# @alley:end is where he gets away; @exit is the street you can leave by while the door is open.
name: sylar_shop
anchor: 14 1 54
palette:
  A = stone
  C = deepslate_tiles
  D = bricks
  E = cobblestone
  H = mossy_cobblestone
  I = dark_oak_planks
  J = spruce_planks
  K = polished_blackstone
  L = waxed_cut_copper
  M = calcite
  N = polished_blackstone_bricks
  O = chiseled_polished_blackstone @center
  P = stone_bricks
  Q = polished_andesite
  R = cracked_stone_bricks
  S = black_concrete
  T = air @alley:end
  U = barrel[facing=up]
  V = composter
  W = spruce_trapdoor[facing=east,half=bottom,open=false]
  X = cauldron
  B = spruce_planks @door:back
  Y = dark_oak_stairs[facing=west,half=top]
  Z = stripped_dark_oak_log[axis=y]
  a = air @pendulum
  b = dark_oak_stairs[facing=east,half=top]
  c = dark_oak_stairs[facing=south,half=top]
  d = dark_oak_stairs[facing=north,half=bottom]
  e = waxed_copper_block @rail:n
  f = air @spawn:sylar
  g = air @spawn:quarry
  h = waxed_copper_block @rail:s
  i = dark_oak_slab[type=top]
  F = air @door:front
  j = dark_oak_fence
  k = air @exit
  l = mud_bricks
  G = glass @case
  m = lantern[hanging=false]
  n = tripwire_hook[facing=south]
  o = brown_candle[candles=3,lit=true]
  p = dark_oak_pressure_plate
  q = flower_pot
  r = dark_oak_trapdoor[facing=south,half=bottom,open=false]
  s = waxed_copper_grate
  t = glass_pane
  u = stripped_spruce_wood
  v = dark_oak_slab[type=bottom]
  w = lightning_rod[facing=up]
  x = dark_oak_stairs[facing=east,half=bottom]
  y = dark_oak_stairs[facing=west,half=bottom]
  z = air @frame:south
  0 = air @frame:east
  1 = air @frame:west
  2 = dark_oak_wall_sign[facing=south] @sign:shop
  3 = chiseled_polished_blackstone @great_clock
  4 = lantern[hanging=true]
  5 = chain[axis=y]
  6 = stripped_dark_oak_log[axis=x]
signs:
  shop black = | GRAY & SONS | Watch Repair |

