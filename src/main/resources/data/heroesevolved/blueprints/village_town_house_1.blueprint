# A town house villages build at the Town tier (village/Projects): front gable to the street, stone
# ground floor, jettied timber-frame upper floor. Drawn facing north; village/Styles recolours it per
# village kind. Exported with to-nbt to structure/village/town_house_1.nbt: export again after any change.
name: village_town_house_1
anchor: 0 0 0
palette:
  A = cobblestone
  B = oak_planks
  C = oak_log[axis=y]
  D = mossy_cobblestone
  E = oak_door[facing=south,half=lower,hinge=left]
  F = crafting_table
  G = oak_stairs[facing=north,half=bottom]
  H = chest[facing=east]
  I = oak_fence
  J = furnace[facing=east]
  K = oak_stairs[facing=south,half=bottom]
  L = barrel[facing=up]
  M = glass_pane
  N = oak_door[facing=south,half=upper,hinge=left]
  O = oak_pressure_plate
  P = oak_stairs[facing=south,half=top]
  Q = lantern[hanging=true]
  R = oak_log[axis=x]
  S = oak_log[axis=z]
  T = potted_red_tulip
  U = potted_cornflower
  V = white_terracotta
  W = red_carpet
  X = red_bed[facing=south,part=foot]
  Y = white_bed[facing=south,part=foot]
  Z = red_bed[facing=south,part=head]
  a = white_bed[facing=south,part=head]
  b = dark_oak_stairs[facing=east,half=bottom]
  c = dark_oak_stairs[facing=west,half=bottom]
  d = chain[axis=y]
  e = dark_oak_slab[type=bottom]

