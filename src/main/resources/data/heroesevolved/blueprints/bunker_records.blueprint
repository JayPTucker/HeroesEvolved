# Records and communications. The radio console sits on the east desk, facing the room: a Simple Radio receiver with a
# transmitter stacked on it, a speaker and a microphone beside it; the operator's chair is on the room side.
name: bunker_records
anchor: 5 0 0
palette:
  A = polished_deepslate
  B = white_concrete
  C = black_concrete
  D = yellow_concrete
  E = deepslate_tiles
  F = dark_oak_stairs[facing=south]
  G = smooth_quartz_slab[type=top]
  H = barrel[facing=east]
  I = white_carpet
  J = bookshelf
  K = dark_oak_stairs[facing=north]
  L = chiseled_bookshelf[facing=west,slot_0_occupied=true,slot_2_occupied=true,slot_4_occupied=true]
  M = lectern[facing=south] @log:lockdown
  O = barrel[facing=up]
  P = chest[facing=north] @loot:records
  Q = tuff_bricks
  T = lantern[hanging=false]
  U = barrel[facing=up,open=true]
  W = cobweb
  X = iron_trapdoor[facing=east,half=bottom,open=false]
  Y = iron_trapdoor[facing=north,open=true,half=bottom]
  Z = iron_trapdoor[facing=west,open=true,half=bottom]
  a = waxed_exposed_copper_bulb[lit=true]
  b = iron_trapdoor[facing=east,open=true,half=bottom]
  c = iron_trapdoor[facing=south,open=true,half=bottom]
  d = deepslate_bricks
  e = red_stained_glass
  f = simpleradio:receiver[facing=south] @signal:receiver
  g = simpleradio:transmitter[facing=south] @signal:display
  h = simpleradio:speaker[facing=south] @signal:speaker
  i = simpleradio:microphone[rotation=0] @signal:microphone
  j = spruce_wall_sign[facing=south] @sign:receiver
  N = waxed_weathered_cut_copper_slab[type=top]
signs:
  receiver light_blue glow = SIGNAL RECEIVER | USE CONSOLE | SURFACE RELAY

