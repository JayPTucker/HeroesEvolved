# Security checkpoint with lockers, emergency supplies and a marked maintenance hatch.
name: bunker_security
anchor: 0 0 0
palette:
  A = polished_deepslate
  B = yellow_concrete
  C = black_concrete
  D = spruce_trapdoor[facing=north,half=top,open=false]
  E = deepslate_tiles
  F = iron_bars
  G = smooth_quartz_slab[type=top]
  H = dark_oak_stairs[facing=west]
  J = barrel[facing=north]
  K = chest[facing=north] @loot:security
  L = barrel[facing=up]
  M = tuff_bricks
  N = gray_concrete
  O = lever[face=floor,facing=east]
  P = light_blue_stained_glass
  Q = iron_trapdoor[facing=north,open=true,half=bottom]
  R = spruce_wall_sign[facing=east] @sign:checkpoint
  S = iron_trapdoor[facing=west,open=true,half=bottom]
  T = waxed_oxidized_copper_bulb[lit=false]
  U = iron_trapdoor[facing=east,open=true,half=bottom]
  V = iron_trapdoor[facing=south,open=true,half=bottom]
  W = iron_trapdoor[facing=north,half=bottom,open=false]
  X = cobweb
  Y = chain[axis=y]
  Z = deepslate_bricks
  a = red_stained_glass
  b = waxed_copper_bulb[lit=true]
  d = spruce_wall_sign[facing=north] @sign:maintenance_hatch
signs:
  checkpoint white glow = CHECKPOINT | EMERGENCY | SUPPLIES
  maintenance_hatch white glow = MAINTENANCE | ACCESS HATCH | DOWN

