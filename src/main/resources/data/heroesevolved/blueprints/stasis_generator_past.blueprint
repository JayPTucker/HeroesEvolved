# Generated by tools/generate-bunker.py; change the script, not this file.
# The generator hall: the core, fourteen power cells, the catwalk and the main breaker.
# As it was on the Last Day and the lockdown nights (PastBunker).
# Placed with its grid corner at bunker 21 0 9 (BunkerLayout).
name: stasis_generator_past
anchor: 0 0 0
palette:
  A = polished_deepslate
  B = chiseled_tuff_bricks
  C = deepslate_tiles
  D = waxed_copper_block
  E = polished_deepslate_slab[type=bottom]
  F = polished_deepslate_stairs[facing=north,half=bottom]
  G = waxed_copper_bulb[lit=true,powered=false]
  H = iron_bars
  I = light_blue_stained_glass
  J = sea_lantern
  K = lever[face=wall,facing=east,powered=false]
  L = waxed_cut_copper
  M = spruce_wall_sign[facing=south] @sign:cells
  N = pearlescent_froglight
  O = lightning_rod[facing=up]
  P = spruce_wall_sign[facing=east] @sign:breaker
  Q = polished_deepslate_slab[type=top]
  R = waxed_cut_copper_slab[type=top]
  S = waxed_copper_trapdoor[facing=north,open=true,half=top]
  T = waxed_copper_trapdoor[facing=west,open=true,half=top]
  U = waxed_copper_trapdoor[facing=east,open=true,half=top]
  V = waxed_copper_trapdoor[facing=south,open=true,half=top]
  W = heroesevolved:alarm_beacon[facing=east,lit=true] @beacon
  X = chain
  Y = heroesevolved:alarm_beacon[facing=west,lit=true] @beacon
  Z = deepslate_bricks
signs:
  cells green glow = POWER CELLS | 14 OF 14 | NOMINAL | 
  breaker red glow = MAIN BREAKER | SUBLEVEL 4 | DO NOT | OPERATE

